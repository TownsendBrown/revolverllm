# Absolute host path to GGUF models (bind-mounted into manager at /models).
MODELS_DIR=/Users/monkeyland/Downloads/Revolver-main/models

# Manager HTTP API port
MANAGER_PORT=3099

# Unix socket on host (created by host-agent; mounted into manager container)
# Default: mac/data/revolver-llama.sock — set only if using a custom path
# REVOLVER_LLAMA_SOCKET=/path/to/revolver-llama.sock

# Optional: explicit path to Metal llama-server binary on the Mac host
# LLAMA_SERVER_BIN=/opt/homebrew/bin/llama-server
