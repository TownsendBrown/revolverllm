# Host directory containing GGUF models (bind-mounted into containers).
# MUST be an ABSOLUTE host path — the backend forwards this to the host Docker
# daemon when spawning per-server llama.cpp containers, and relative paths
# (e.g. ./models) will not resolve there.
MODELS_DIR=/absolute/path/to/models

# Optional: local metadata root alongside models
# REVOLVER_LOCAL_ROOT=/models/.revolver

FRONTEND_PORT=8080
BACKEND_PORT=3001

# OpenAI-compatible gateway for external clients (Cline, etc.)
GATEWAY_PORT=8081

# Control-plane + gateway Bearer token (required for /api/* when set).
# Compose frontend nginx injects this on proxied /api requests.
# Generate: openssl rand -hex 24
REVOLVER_API_KEY=

# Hugging Face token for gated models and the in-app downloader (optional).
HF_TOKEN=

# Absolute host path to this repo — needed so the compose backend can
# `docker build` LiveCodeBench / EvalPlus harness images on first use.
# Also used when mounting benchmark work dirs. Example: /home/you/revolver
# REVOLVER_HOST_ROOT=/absolute/path/to/revolver

# Coding benchmarks (Docker harnesses). Build images with:
#   docker compose --profile bench build livecodebench evalplus
# Results come back over stdout + `docker cp`, so no host path mapping is needed.
# REVOLVER_LCB_IMAGE=revolver/livecodebench:local
# REVOLVER_LCB_FULL=0
# REVOLVER_LCB_RELEASE=release_v1
# REVOLVER_EVALPLUS_IMAGE=revolver/evalplus:local
# REVOLVER_EVALPLUS_DATASET=humaneval
# REVOLVER_EVALPLUS_MINI=1

# Completion budgets. Reasoning models spend most of the budget thinking and
# return empty answers below these values, which scores as 0% rather than as a
# broken run — raise them further for models with long thinking traces.
# REVOLVER_EVALPLUS_MAX_NEW_TOKENS=4096
# REVOLVER_LCB_MAX_TOKENS=8000
# Use `reasoning_content` when a server returns thinking but empty content.
# REVOLVER_EVALPLUS_REASONING_FALLBACK=1
# REVOLVER_LCB_REASONING_FALLBACK=1

# Harness containers execute model-generated code — cap what they can consume.
# REVOLVER_BENCH_CPUS=8
# REVOLVER_BENCH_MEMORY=8g
# REVOLVER_BENCH_PIDS_LIMIT=2048
# Keep the copied-out work dir (generations, eval json) for inspection.
# REVOLVER_BENCH_KEEP_WORK=1
# Wall-clock budgets. HumanEval mini is 164 problems; at ~30s each that is
# already past 1 hour, so EvalPlus defaults to 3h. LiveCodeBench debug (15) is
# ~20–30 min; default 2h covers a slow reasoning model.
# REVOLVER_EVALPLUS_TIMEOUT_MS=10800000
# REVOLVER_LCB_TIMEOUT_MS=7200000

# Host path to nvidia-smi (GPU overlay mounts it into the backend for NVIDIA monitoring)
NVIDIA_SMI_HOST_PATH=/usr/bin/nvidia-smi
# AMD GPUs are enumerated from host sysfs (mounted at /host/sys in compose). No extra env.

# Native llama-server (Electron / `npm run server` only — ignored inside Compose).
# Linux CUDA packs (sm_70 / Pascal): ./backends/build.sh sm70 && npm run install:llama-server
# macOS Metal: mac/scripts/install-llama-server.sh
# Override:
# LLAMA_SERVER_BIN=/usr/local/bin/llama-server
# Force a pack id:
# REVOLVER_BACKEND_PACK=linux-cuda-sm70
# Default runtime for new servers when the UI does not pick one:
# REVOLVER_RUNTIME=docker

# vLLM container images (spawned per-server by the backend)
# VLLM_IMAGE=vllm/vllm-openai:latest
# VLLM_LEGACY_IMAGE=revolver/vllm-pascal:0.9.1
# VLLM_LEGACY_SHM_SIZE=10g
