# Host directory containing GGUF models (bind-mounted into containers).
# MUST be an ABSOLUTE host path — the backend forwards this to the host Docker
# daemon when spawning per-server llama.cpp containers, and relative paths
# (e.g. ./models) will not resolve there.
MODELS_DIR=/absolute/path/to/models

# Optional: local metadata root alongside models
# REVOLVER_LOCAL_ROOT=/models/.revolver

FRONTEND_PORT=8080
BACKEND_PORT=3001

# Host path to nvidia-smi (GPU overlay mounts it into the backend for monitoring)
NVIDIA_SMI_HOST_PATH=/usr/bin/nvidia-smi
