{
  "name": "revolver",
  "version": "0.2.0",
  "description": "Local model manager for GGUF files",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "npm run rebuild:native && env -u ELECTRON_RUN_AS_NODE ELECTRON_NO_SANDBOX=1 vite",
    "build": "vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "server": "tsx server/index.ts",
    "start": "npm run rebuild:native && npm run build && env -u ELECTRON_RUN_AS_NODE ELECTRON_NO_SANDBOX=1 electron . --no-sandbox",
    "start:macos": "mac/scripts/start-electron-macos.sh",
    "start:native": "scripts/start-electron-native.sh",
    "dev:native": "scripts/start-electron-native.sh --dev",
    "install:llama-server": "scripts/install-llama-server.sh",
    "backend:build:sm70": "bash backends/linux/cuda-sm70/build.sh",
    "backend:build:pascal": "bash backends/linux/cuda-pascal/build.sh",
    "pack": "npm run rebuild:native && npm run build && electron-builder --linux",
    "pack:dir": "npm run rebuild:native && npm run build && electron-builder --linux dir",
    "pack:native": "scripts/pack-electron-native.sh",
    "pack:native:dir": "scripts/pack-electron-native.sh dir",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "docker:up": "scripts/docker-up.sh up --build",
    "docker:up:gpu": "scripts/docker-up.sh -f docker-compose.yml -f docker-compose.gpu.yml up --build",
    "docker:up:mac": "mac/scripts/docker-up-mac.sh",
    "host-agent": "mac/scripts/run-host-agent.sh",
    "host-agent:stop": "mac/scripts/stop-host-agent.sh",
    "host-open-agent": "scripts/run-host-open-agent.sh",
    "host-open-agent:stop": "scripts/stop-host-open-agent.sh",
    "test": "tsx --test engines/*.test.ts shared/*.test.ts shared/benchmarks/*.test.ts server/*.test.ts electron/lib/*.test.ts",
    "test:native": "tsx --test shared/runtimeMode.test.ts shared/nativeBackends.test.ts server/gpuClaims.test.ts server/llamaServerBin.test.ts server/nativeBackends.test.ts test/native/*.test.ts",
    "benchmark:e2e": "tsx scripts/run-benchmark-e2e.ts"
  },
  "build": {
    "appId": "ai.revolver.app",
    "productName": "Revolver",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json",
      "node_modules/better-sqlite3/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "synopsis": "Local model manager for GGUF files"
    }
  },
  "dependencies": {
    "@huggingface/gguf": "^0.3.2",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "katex": "^0.17.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  }
}
