{
  "name": "revolver",
  "version": "0.2.0",
  "description": "Local model manager for GGUF files",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE ELECTRON_NO_SANDBOX=1 vite",
    "build": "vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "server": "tsx server/index.ts",
    "start": "env -u ELECTRON_RUN_AS_NODE ELECTRON_NO_SANDBOX=1 electron .",
    "pack": "npm run build && electron-builder --linux dir",
    "docker:up": "docker compose up --build",
    "docker:up:gpu": "docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build"
  },
  "build": {
    "appId": "ai.revolver.app",
    "productName": "Revolver",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@huggingface/gguf": "^0.3.2",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "katex": "^0.17.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  }
}
